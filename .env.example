# Database — leave unset locally to use ./local.db (SQLite file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Salt used to hash anonymous device IDs and IPs (any long random string)
HASH_SALT=change-me-to-a-long-random-string

# Admin (GitHub OAuth via Auth.js)
AUTH_SECRET=          # generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub usernames allowed into /admin
ADMIN_GITHUB_LOGINS=your-github-username
